---
// Ürün tipine göre üretilen sade ürün çizimleri (marka görseli kullanılmaz).
const { kind = 'switch', v = {}, label = '', size = 'md', bare = false } = Astro.props;
const ports = (n, x, y, w = 14, h = 11, gap = 4, rows = 2, color = '#1f2937') => {
  const per = Math.ceil(n / rows); const out = [];
  for (let r = 0; r < rows; r++) for (let i = 0; i < per && r * per + i < n; i++)
    out.push(`<rect x="${x + i * (w + gap) + Math.floor(i / 6) * 6}" y="${y + r * (h + 4)}" width="${w}" height="${h}" rx="1.5" fill="${color}"/><rect x="${x + i * (w + gap) + Math.floor(i / 6) * 6 + 3}" y="${y + r * (h + 4) + 1}" width="${w - 6}" height="2" fill="#4b5563"/>`);
  return out.join('');
};
const leds = (x, y, n, c = '#22c55e') => Array.from({ length: n }, (_, i) => `<circle cx="${x + i * 9}" cy="${y}" r="2.4" fill="${i % 3 === 2 ? '#f59e0b' : c}"/>`).join('');
const rackBody = (u) => {
  const h = Math.min(230, 60 + u * 4); const y = 270 - h;
  let units = '';
  const shown = Math.min(u, 10);
  for (let i = 0; i < shown; i++) units += `<rect x="150" y="${y + 18 + i * ((h - 40) / shown)}" width="100" height="${Math.max(6, (h - 40) / shown - 4)}" rx="2" fill="${i % 3 === 0 ? '#334155' : '#1f2937'}"/>` + (i % 3 === 0 ? `<circle cx="240" cy="${y + 22 + i * ((h - 40) / shown)}" r="1.8" fill="#22c55e"/>` : '');
  return `<rect x="135" y="${y}" width="130" height="${h}" rx="6" fill="#0f172a"/><rect x="142" y="${y + 8}" width="116" height="${h - 16}" rx="3" fill="#111827" stroke="#334155"/>${units}<rect x="140" y="${y + h}" width="10" height="8" fill="#0f172a"/><rect x="250" y="${y + h}" width="10" height="8" fill="#0f172a"/>`;
};
let body = '';
switch (kind) {
  case 'switch':
  case 'router': {
    const n = v.ports || 24; const rows = n > 8 ? 2 : 1;
    const pw = n > 30 ? 9 : 14;
    body = `<rect x="30" y="120" width="340" height="62" rx="6" fill="#e5e7eb" stroke="#9ca3af"/><rect x="30" y="120" width="340" height="10" rx="5" fill="#d1d5db"/>
      ${ports(n, 70, rows === 2 ? 137 : 145, pw, 11, n > 30 ? 2 : 3, rows, v.poe ? '#1e3a8a' : '#1f2937')}
      ${ports(v.sfp || 0, 318, rows === 2 ? 137 : 145, 18, 10, 4, Math.min(2, v.sfp || 1), '#64748b')}
      ${leds(42, 140, 2)}<text x="42" y="172" font-size="8" font-family="Arial" fill="#6b7280">${kind === 'router' ? 'ROUTER' : v.poe ? 'PoE+' : 'SWITCH'}</text>`;
    break;
  }
  case 'firewall':
    body = v.rack
      ? `<rect x="30" y="122" width="340" height="56" rx="6" fill="#b91c1c"/><rect x="30" y="122" width="340" height="9" rx="4" fill="#dc2626"/>${ports(Math.min(v.ports, 22), 80, 138, 12, 10, 3, 2)}${leds(44, 145, 2)}`
      : `<rect x="90" y="120" width="220" height="70" rx="10" fill="#b91c1c"/><rect x="90" y="120" width="220" height="16" rx="8" fill="#dc2626"/>${ports(v.ports || 5, 140, 150, 14, 12, 5, 1)}${leds(104, 160, 2)}<path d="M100 200h200" stroke="#7f1d1d" stroke-width="6" stroke-linecap="round"/>`;
    break;
  case 'ap':
    body = `<ellipse cx="200" cy="160" rx="92" ry="92" fill="#f8fafc" stroke="#cbd5e1" stroke-width="3"/><ellipse cx="200" cy="160" rx="70" ry="70" fill="#fff" stroke="#e2e8f0"/><circle cx="200" cy="160" r="9" fill="#38bdf8"/><circle cx="200" cy="160" r="20" fill="none" stroke="#38bdf8" stroke-opacity=".35" stroke-width="3"/>
      <path d="M150 70a70 70 0 0 1 100 0M165 52a95 95 0 0 1 70 0" stroke="#94a3b8" stroke-width="4" fill="none" stroke-linecap="round"/>`;
    break;
  case 'server':
    body = `<rect x="40" y="110" width="320" height="86" rx="6" fill="#1f2937"/><rect x="48" y="118" width="304" height="70" rx="3" fill="#111827"/>
      ${Array.from({ length: 8 }, (_, i) => `<rect x="${58 + i * 30}" y="126" width="24" height="54" rx="2" fill="#374151" stroke="#4b5563"/><circle cx="${70 + i * 30}" cy="173" r="2" fill="#22c55e"/>`).join('')}
      <rect x="306" y="126" width="38" height="54" rx="3" fill="#0f172a"/>${leds(314, 140, 3, '#38bdf8')}`;
    break;
  case 'tower':
    body = `<rect x="140" y="60" width="120" height="210" rx="8" fill="#1f2937"/><rect x="150" y="72" width="100" height="40" rx="3" fill="#111827"/><rect x="158" y="80" width="84" height="8" fill="#374151"/><rect x="158" y="94" width="84" height="8" fill="#374151"/>
      ${Array.from({ length: 9 }, (_, i) => `<rect x="152" y="${124 + i * 14}" width="96" height="6" rx="3" fill="#0f172a"/>`).join('')}<circle cx="200" cy="255" r="6" fill="#38bdf8"/>`;
    break;
  case 'nas':
    body = `<rect x="110" y="80" width="180" height="180" rx="12" fill="#111827"/>${Array.from({ length: 4 }, (_, i) => `<rect x="${126 + i * 38}" y="98" width="32" height="140" rx="3" fill="#1f2937" stroke="#374151"/><circle cx="${142 + i * 38}" cy="228" r="2.5" fill="#22c55e"/>`).join('')}<text x="200" y="252" text-anchor="middle" font-size="9" font-family="Arial" fill="#9ca3af">NAS</text>`;
    break;
  case 'rack':
  case 'mdc':
    body = rackBody(v.u || 42) + (kind === 'mdc' ? `<rect x="268" y="${270 - Math.min(230, 60 + (v.u || 24) * 4) + 20}" width="36" height="60" rx="4" fill="#e2e8f0"/><path d="M276 ${270 - Math.min(230, 60 + (v.u || 24) * 4) + 34}h20M276 ${270 - Math.min(230, 60 + (v.u || 24) * 4) + 44}h20M276 ${270 - Math.min(230, 60 + (v.u || 24) * 4) + 54}h20" stroke="#38bdf8" stroke-width="3"/>` : '');
    break;
  case 'wallrack':
    body = `<rect x="110" y="100" width="180" height="140" rx="6" fill="#0f172a"/><rect x="120" y="110" width="160" height="120" rx="3" fill="#94a3b8" fill-opacity=".25" stroke="#cbd5e1"/>${Array.from({ length: 4 }, (_, i) => `<rect x="134" y="${122 + i * 26}" width="132" height="16" rx="2" fill="#1f2937"/>`).join('')}<rect x="272" y="160" width="6" height="22" rx="2" fill="#cbd5e1"/>`;
    break;
  case 'pdu':
    body = `<rect x="30" y="138" width="340" height="40" rx="5" fill="#111827"/>${Array.from({ length: 8 }, (_, i) => `<rect x="${70 + i * 34}" y="146" width="24" height="24" rx="4" fill="#1f2937" stroke="#4b5563"/><circle cx="${78 + i * 34}" cy="158" r="2" fill="#6b7280"/><circle cx="${86 + i * 34}" cy="158" r="2" fill="#6b7280"/>`).join('')}<rect x="40" y="148" width="18" height="20" rx="3" fill="#dc2626"/>`;
    break;
  case 'ups':
    body = `<rect x="40" y="115" width="320" height="80" rx="6" fill="#1f2937"/><rect x="48" y="123" width="210" height="64" rx="3" fill="#111827"/>${Array.from({ length: 14 }, (_, i) => `<rect x="${56 + i * 14}" y="130" width="6" height="50" rx="3" fill="#0b1220"/>`).join('')}
      <rect x="270" y="130" width="76" height="30" rx="3" fill="#0ea5e9" fill-opacity=".85"/><text x="308" y="150" text-anchor="middle" font-size="11" font-family="Arial" fill="#e0f2fe">ONLINE</text>${leds(280, 174, 4)}`;
    break;
  case 'upstower':
    body = `<rect x="${v.small ? 155 : 135}" y="${v.small ? 130 : 70}" width="${v.small ? 90 : 130}" height="${v.small ? 140 : 200}" rx="10" fill="#1f2937"/><rect x="${v.small ? 170 : 155}" y="${v.small ? 146 : 90}" width="${v.small ? 60 : 90}" height="28" rx="3" fill="#0ea5e9" fill-opacity=".85"/>${leds(v.small ? 178 : 168, v.small ? 190 : 140, 4)}<circle cx="200" cy="${v.small ? 240 : 230}" r="9" fill="#111827" stroke="#38bdf8" stroke-width="2"/>`;
    break;
  case 'cable':
  case 'fiber': {
    const c = v.color || '#9aa3ad';
    body = `<ellipse cx="200" cy="170" rx="110" ry="96" fill="#d6c7a8"/><ellipse cx="200" cy="170" rx="92" ry="80" fill="${c}"/>
      ${Array.from({ length: 6 }, (_, i) => `<ellipse cx="200" cy="170" rx="${88 - i * 9}" ry="${76 - i * 8}" fill="none" stroke="#000" stroke-opacity=".12" stroke-width="2"/>`).join('')}
      <ellipse cx="200" cy="170" rx="34" ry="30" fill="#bfa982"/><ellipse cx="200" cy="170" rx="14" ry="12" fill="#f8fafc"/>
      <path d="M290 150 C 330 140, 350 190, 380 200" stroke="${c}" stroke-width="10" fill="none" stroke-linecap="round"/>${kind === 'fiber' ? '<circle cx="382" cy="201" r="5" fill="#38bdf8"/>' : '<rect x="372" y="194" width="18" height="14" rx="2" fill="#e5e7eb" stroke="#9ca3af"/>'}`;
    break;
  }
  case 'patchcord':
  case 'fiberpatch': {
    const c = v.color || '#2f80ed';
    body = `<path d="M70 120 C 140 40, 260 40, 330 120 S 260 250, 200 210 S 90 200, 70 120" stroke="${c}" stroke-width="${kind === 'fiberpatch' ? 6 : 9}" fill="none" stroke-linecap="round"/>
      <rect x="52" y="108" width="34" height="24" rx="4" fill="${kind === 'fiberpatch' ? '#f1f5f9' : '#e5e7eb'}" stroke="#94a3b8"/><rect x="314" y="108" width="34" height="24" rx="4" fill="${kind === 'fiberpatch' ? '#f1f5f9' : '#e5e7eb'}" stroke="#94a3b8"/>
      ${kind === 'fiberpatch' ? '<rect x="40" y="113" width="12" height="6" fill="#38bdf8"/><rect x="40" y="121" width="12" height="6" fill="#38bdf8"/><rect x="348" y="113" width="12" height="6" fill="#38bdf8"/><rect x="348" y="121" width="12" height="6" fill="#38bdf8"/>' : '<rect x="44" y="113" width="10" height="14" rx="1" fill="#cbd5e1"/><rect x="346" y="113" width="10" height="14" rx="1" fill="#cbd5e1"/>'}`;
    break;
  }
  case 'patchpanel':
  case 'odf':
    body = `<rect x="30" y="130" width="340" height="46" rx="4" fill="#111827"/>${ports(v.ports || 24, 66, kind === 'odf' ? 140 : 144, kind === 'odf' ? 9 : 14, kind === 'odf' ? 9 : 11, kind === 'odf' ? 3 : 4, kind === 'odf' ? 2 : 1, kind === 'odf' ? '#38bdf8' : '#e5e7eb')}<circle cx="44" cy="153" r="4" fill="#374151"/><circle cx="356" cy="153" r="4" fill="#374151"/>`;
    break;
  case 'keystone':
    body = Array.from({ length: 6 }, (_, i) => `<g transform="translate(${80 + (i % 3) * 90} ${100 + Math.floor(i / 3) * 90})"><rect width="60" height="70" rx="6" fill="#f8fafc" stroke="#94a3b8"/><rect x="14" y="12" width="32" height="26" rx="3" fill="#1f2937"/><rect x="10" y="48" width="40" height="12" rx="2" fill="#2f80ed" fill-opacity=".7"/></g>`).join('');
    break;
  case 'splicer':
    body = `<rect x="110" y="120" width="180" height="110" rx="12" fill="#f59e0b"/><rect x="128" y="132" width="90" height="62" rx="4" fill="#0f172a"/><path d="M140 168h66" stroke="#38bdf8" stroke-width="3"/><rect x="228" y="140" width="48" height="76" rx="6" fill="#1f2937"/><circle cx="252" cy="160" r="8" fill="#374151"/><rect x="140" y="204" width="60" height="12" rx="3" fill="#b45309"/><path d="M60 150h50M290 150h50" stroke="#38bdf8" stroke-width="3"/>`;
    break;
  case 'detector':
    body = v.type === 'tank'
      ? `<rect x="160" y="70" width="80" height="190" rx="36" fill="#dc2626"/><rect x="180" y="52" width="40" height="24" rx="6" fill="#374151"/><rect x="172" y="120" width="56" height="44" rx="4" fill="#fff" fill-opacity=".9"/><text x="200" y="146" text-anchor="middle" font-size="10" font-family="Arial" fill="#991b1b">GAZ</text>`
      : v.type === 'sensor'
      ? `<rect x="60" y="140" width="200" height="40" rx="4" fill="#111827"/>${leds(80, 160, 5)}<circle cx="300" cy="120" r="30" fill="#f8fafc" stroke="#94a3b8"/><path d="M300 104v20" stroke="#ef4444" stroke-width="5" stroke-linecap="round"/><circle cx="300" cy="130" r="7" fill="#ef4444"/><path d="M290 210 q10 -18 20 0 a10 10 0 1 1 -20 0z" fill="#38bdf8"/>`
      : `<ellipse cx="200" cy="170" rx="100" ry="34" fill="#e2e8f0"/><path d="M110 168 a90 90 0 0 1 180 0z" fill="#f8fafc" stroke="#cbd5e1" stroke-width="2"/><circle cx="200" cy="138" r="6" fill="#ef4444"/>${Array.from({ length: 8 }, (_, i) => `<rect x="${136 + i * 16}" y="150" width="8" height="12" rx="2" fill="#cbd5e1"/>`).join('')}`;
    break;
}
---
<svg class={`art art-${size}`} viewBox="0 0 400 300" role="img" aria-label={label}>
  <defs><radialGradient id="g" cx="50%" cy="40%" r="70%"><stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#eef2f6"/></radialGradient></defs>
  {!bare && <rect width="400" height="300" fill="url(#g)"/>}
  <ellipse cx="200" cy="278" rx="150" ry="10" fill="#0f172a" fill-opacity=".07"/>
  <g set:html={body} />
</svg>
